{
    "presets": [
        [
            "@babel/preset-env",
            {
                "useBuiltIns": "usage",
                "corejs": "3.49"
            }
        ],
        "@babel/preset-react"
    ],
    "overrides": [
        {
            "test": "./src",
            "plugins": ["@babel/plugin-transform-flow-strip-types"]
        }
    ],
    "exclude": ["node_modules/core-js/**"]
}

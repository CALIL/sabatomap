{
  "name": "sabatomap",
  "version": "1.7.0-dev",
  "description": "鯖江市図書館マップアプリ「さばとマップ」",
  "repositry": "https://github.com/CALIL/sabatomap",
  "scripts": {
    "start": "npm run copy && npm run compile && npx cordova prepare && npx cordova run browser",
    "compile": "browserify -g babelify -g uglifyify --entry src/app.js > www/js/all.js",
    "copy": "npm run compile && gulp sass && gulp copy_css && gulp copy_fonts && gulp copy_jsons",
    "release": "npm run copy && npx cordova run android --release",
    "build": "npm run copy && npx cordova run android",
    "build_ios": "npm run copy && npx cordova run ios --target='iPhone-14'",
    "build_browser": "browserify -g babelify -g uglifyify --entry src/app.js > www/js/all.js"
  },
  "dependencies": {
    "cordova-browser": "^7.0.0",
    "cordova-plugin-bluetooth-status": "~1.0.4",
    "cordova-plugin-wkwebview": "^0.6.10",
    "geolib": "^3.3.14",
    "ol": "^5.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "superagent": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-flow-strip-types": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/register": "^7.29.7",
    "autoprefixer": "^10.5.4",
    "babelify": "^10.0.0",
    "browserify": "^17.0.1",
    "com.unarin.cordova.beacon": "github:CALIL/cordova-plugin-ibeacon",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.1.1",
    "cordova-lib": "^13.0.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-device-orientation": "github:CALIL/cordova-plugin-device-orientation",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "cordova-plugin-network-information": "^3.1.0",
    "core-js": "^3.49.0",
    "gulp": "^5.0.0",
    "gulp-postcss": "^10.0.0",
    "gulp-replace": "^1.0.0",
    "gulp-sass": "^6.0.1",
    "postcss": "^8.5.25",
    "postcss-assets": "^6.0.0",
    "sass": "^1.102.0",
    "uglifyify": "^5.0.2",
    "vinyl-source-stream": "^2.0.0"
  },
  "author": "CALIL Inc.",
  "license": "MIT",
  "cordova": {
    "platforms": [
      "browser",
      "android",
      "ios"
    ],
    "plugins": {
      "cordova-plugin-bluetooth-status": {},
      "com.unarin.cordova.beacon": {},
      "cordova-plugin-device-orientation": {},
      "cordova-plugin-network-information": {},
      "cordova-plugin-inappbrowser": {}
    }
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "overrides": {
    "terser": "^4.8.1",
    "uuid": "^11.1.1"
  }
}

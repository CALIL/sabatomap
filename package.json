{
  "name": "sabatomap",
  "version": "1.7.0-dev",
  "description": "鯖江市図書館マップアプリ「さばとマップ」",
  "repositry": "https://github.com/CALIL/sabatomap",
  "scripts": {
    "start": "npm run copy && npx cordova prepare && npx cordova run browser",
    "copy": "node tools/build.mjs release",
    "compile": "node tools/build.mjs release",
    "build_browser": "node tools/build.mjs release",
    "watch": "node tools/build.mjs watch",
    "clean": "node tools/build.mjs clean",
    "release": "npm run copy && npx cordova run android --release",
    "build": "npm run copy && npx cordova run android",
    "build_ios": "npm run copy && npx cordova run ios --target='iPhone-14'",
    "test": "vitest run"
  },
  "dependencies": {
    "cordova-browser": "^7.0.0",
    "cordova-plugin-bluetooth-status": "~1.0.4",
    "cordova-plugin-wkwebview": "^0.6.10",
    "geolib": "^3.3.14",
    "ol": "^5.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "superagent": "^10.3.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "browserslist": "^4.28.8",
    "com.unarin.cordova.beacon": "github:CALIL/cordova-plugin-ibeacon",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.1.1",
    "cordova-lib": "^13.0.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-device-orientation": "github:CALIL/cordova-plugin-device-orientation",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "cordova-plugin-network-information": "^3.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "postcss-assets": "^6.0.0",
    "sass": "^1.102.0",
    "vitest": "^4.1.10"
  },
  "author": "CALIL Inc.",
  "license": "MIT",
  "cordova": {
    "platforms": [
      "browser",
      "android",
      "ios"
    ],
    "plugins": {
      "cordova-plugin-bluetooth-status": {},
      "com.unarin.cordova.beacon": {},
      "cordova-plugin-device-orientation": {},
      "cordova-plugin-network-information": {},
      "cordova-plugin-inappbrowser": {}
    }
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

# PyCharm
.idea

# Node
npm-debug.log
node_modules


# 先頭の / でリポジトリ直下だけに限定する。これが無いと全階層の www/ に当たり、
# plugins/<plugin>/www/ まで巻き込んで cordova プラグインの JS が追跡から漏れる。
/www/

# iOS
platforms/ios

# android
platforms/android
calil.keystore
android-release.apk

# browser
platforms/browser

# cordova のプラグイン。platforms/ と同じく生成物なので追跡しない（cordova の推奨）。
#
# 唯一のソースは package.json の cordova.plugins と devDependencies で、
# `cordova prepare` が node_modules から plugins/ を組み立てる。
#
# コミットしていた頃は cordova-lib の restore-util.js が
# 「plugins/<id>/ があるなら導入済み」と判断して node_modules を見に行かないため、
# package.json を上げてもビルド内容が変わらなかった。実際に
# cordova-plugin-device-orientation が宣言 3.0.1-dev / 実体 3.0.0-dev でずれていた。
# Dependabot の bump PR も package-lock.json しか触らないので効かなかった。
#
# git 参照のプラグインは SHA で固定してあるので、追跡をやめても解決先は動かない。
/plugins/

# platforms/ 以下と対で意味を持つ状態ファイル。plugins/*.json と同じ理由で追跡しない。
# コミットされていた頃の中身は browser 5.0.4 / android 6.4.0 / ios 4.5.5 で、
# package.json の cordova-browser ^7 / cordova-android ^15.1 / cordova-ios ^8.1 から
# 2〜9 メジャー古い情報が残り続けていた。
platforms/platforms.json

sabatomap-keystore.jks

# CI が Secrets から作る署名設定。パスワードが入るので絶対に追跡しない
build-ci.json

# e2e の実行時生成物。ゴールデン画像（map.spec.mjs-snapshots/）は追跡する
test/e2e/test-results/
test/e2e/playwright-report/
test/e2e/blob-report/
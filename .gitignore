.DS_Store

# PyCharm
.idea

# Node
npm-debug.log
node_modules


# 先頭の / でリポジトリ直下だけに限定する。これが無いと全階層の www/ に当たり、
# plugins/<plugin>/www/ まで巻き込んで cordova プラグインの JS が追跡から漏れる。
/www/

# iOS
platforms/ios

# android
platforms/android
calil.keystore
android-release.apk

# browser
platforms/browser

# cordova のプラグイン導入状態。platforms/ 以下と対で意味を持つファイルで、
# platforms/ を無視している以上これも追跡してはいけない。
#
# コミットされていると cordova-lib の addHelper.js
# installPluginsForNewPlatform() が「このプラットフォームには全部入っている」と
# 判断し、作り直した platforms/<name> にプラグインを 1 件も入れない。
# 手元は platforms/ が残っているので気づけず、クリーンチェックアウトの CI だけが
# プラグイン抜きの APK を焼く。
#
# plugins/fetch.json は導入元と cli_variables の記録でプラットフォームに依らないため、
# 引き続き追跡する。
plugins/android.json
plugins/ios.json
plugins/browser.json

# platforms/ 以下と対で意味を持つ状態ファイル。plugins/*.json と同じ理由で追跡しない。
# コミットされていた頃の中身は browser 5.0.4 / android 6.4.0 / ios 4.5.5 で、
# package.json の cordova-browser ^7 / cordova-android ^15.1 / cordova-ios ^8.1 から
# 2〜9 メジャー古い情報が残り続けていた。
platforms/platforms.json

sabatomap-keystore.jks

# e2e の実行時生成物。ゴールデン画像（map.spec.mjs-snapshots/）は追跡する
test/e2e/test-results/
test/e2e/playwright-report/
test/e2e/blob-report/